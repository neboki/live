{
  "name": "neboki-live",
  "version": "0.0.0",
  "private": true,
  "description": "Live translated captions that float over any call, video or webinar.",
  "author": "Neboki <neboki@neboki.com>",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web && vite build --config vite.landing.config.ts",
    "preview": "vite preview",
    "clean": "node -e \"for (const dir of ['dist', 'coverage', 'test-results', 'playwright-report']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "typecheck": "vue-tsc --build",
    "lint": "pnpm lint:js && pnpm lint:style",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"src/**/*.{scss,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{scss,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "prepare": "lefthook install",
    "build:mobile": "vite build --mode mobile && cap sync android"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "8.6.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.108.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "firebase": "^13.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "packageManager": "pnpm@12.6.0"
}
